# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=c9f4b1e77a2d48c6b0e35af18d92c704
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

# Mailpit faengt lokal alle ausgehenden Mails ab - Oberflaeche auf
# http://localhost:8025. Greift, sobald symfony/mailer installiert ist.
MAILER_DSN=smtp://mailpit:1025

###> doctrine/doctrine-bundle ###
# Host "db" ist der Compose-Service, nicht localhost - der Anwendungscontainer
# erreicht Postgres ueber den Netzwerknamen. Fuer einen Zugriff vom Host aus
# ist der Port auf 127.0.0.1:5432 gemappt, siehe compose.yaml.
#
# Diese Zugangsdaten sind reine Local-Dev-Werte und stehen bewusst im Repo.
# Produktion setzt DATABASE_URL als echte Umgebungsvariable.
DATABASE_URL="postgresql://app:app@db:5432/crm?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> crm/document-module ###
# Objektspeicher fuer Dokumente, S3-kompatibel. Lokal MinIO aus compose.yaml,
# in Produktion S3, Cloudflare R2, Hetzner Object Storage o. ae. - derselbe
# Adapter, nur andere Werte.
#
# Wie bei DATABASE_URL sind das Local-Dev-Werte und keine Geheimnisse.
# Produktion setzt sie als echte Umgebungsvariablen; nichts davon gehoert je
# in eine committete Datei.
STORAGE_ENDPOINT=http://storage:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=crm-documents
STORAGE_KEY=officore
STORAGE_SECRET=officore-dev-passwort

# Groesste zulaessige Datei in Bytes. Serverseitig geprueft - ein
# Formular-Attribut haelt niemanden auf, der die Anfrage selbst baut.
DOCUMENT_MAX_BYTES=26214400
###< crm/document-module ###
