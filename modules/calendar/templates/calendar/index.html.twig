{% extends 'base.html.twig' %}

{% block title %}{{ 'calendar.title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'calendar.title'|trans }}</h1>

    <p><a href="{{ path('calendar_subscription') }}">{{ 'calendar.subscription.link'|trans }}</a></p>

    {% for message in app.flashes('success') %}
        <p class="flash flash--success">{{ message|trans }}</p>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <p class="flash flash--error">{{ message|trans }}</p>
    {% endfor %}

    {% if is_granted('calendar.create') %}
        <form method="post" action="{{ path('calendar_create') }}" class="appointment-form">
            <label for="title">{{ 'calendar.form.title'|trans }}</label>
            <input type="text" id="title" name="title" maxlength="200" required>

            <label for="start">{{ 'calendar.form.start'|trans }}</label>
            <input type="datetime-local" id="start" name="start" required>

            <label for="end">{{ 'calendar.form.end'|trans }}</label>
            <input type="datetime-local" id="end" name="end">

            <label>
                <input type="checkbox" name="all_day" value="1"> {{ 'calendar.form.all_day'|trans }}
            </label>

            <label for="location">{{ 'calendar.form.location'|trans }}</label>
            <input type="text" id="location" name="location" maxlength="200">

            {% if types is not empty %}
                <label for="subject_type">{{ 'calendar.form.subject'|trans }}</label>
                <select id="subject_type" name="subject_type">
                    <option value="">{{ 'calendar.form.subject_none'|trans }}</option>
                    {% for type, label in types %}
                        <option value="{{ type }}">{{ label|trans }}</option>
                    {% endfor %}
                </select>
                <input type="text" name="subject_id" placeholder="{{ 'calendar.form.subject_id'|trans }}">
            {% endif %}

            <button type="submit">{{ 'calendar.form.submit'|trans }}</button>
        </form>
    {% endif %}

    {% if appointments is empty %}
        <p class="muted">{{ 'calendar.list.empty'|trans }}</p>
    {% else %}
        <table class="contact-list__table">
            <thead>
                <tr>
                    <th scope="col">{{ 'calendar.list.column.when'|trans }}</th>
                    <th scope="col">{{ 'calendar.list.column.title'|trans }}</th>
                    <th scope="col">{{ 'calendar.list.column.location'|trans }}</th>
                    <th scope="col">{{ 'calendar.list.column.subject'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for appointment in appointments %}
                    <tr>
                        <td>
                            {% if appointment.allDay %}
                                {{ appointment.startsAt|format_date('medium') }}
                                <span class="muted">{{ 'calendar.list.all_day'|trans }}</span>
                            {% else %}
                                {# Gespeichert ist UTC; format_datetime rechnet in
                                   die Zeitzone des Betrachters um. #}
                                {{ appointment.startsAt|format_datetime('medium', 'short', timezone: 'Europe/Berlin') }}
                                &ndash;
                                {{ appointment.endsAt|format_time('short', timezone: 'Europe/Berlin') }}
                            {% endif %}
                        </td>
                        <td>
                            {{ appointment.title }}
                            {% if appointment.description %}
                                <br><span class="muted">{{ appointment.description }}</span>
                            {% endif %}
                        </td>
                        <td>{{ appointment.location ?? '—' }}</td>
                        <td>
                            {% if appointment.subject %}
                                {% set label = labels[appointment.subject.key]|default(null) %}
                                {% if label %}
                                    {{ label.label }} <span class="muted">({{ label.typeLabel|trans }})</span>
                                {% else %}
                                    <span class="muted">{{ 'calendar.list.unresolved_subject'|trans }}</span>
                                {% endif %}
                            {% else %}
                                <span class="muted">{{ 'calendar.list.no_subject'|trans }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
