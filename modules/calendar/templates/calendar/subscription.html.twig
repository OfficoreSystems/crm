{% extends 'base.html.twig' %}

{% block title %}{{ 'calendar.subscription.title'|trans }}{% endblock %}

{% block body %}
    <p><a href="{{ path('calendar_index') }}">&larr; {{ 'calendar.subscription.back'|trans }}</a></p>

    <h1>{{ 'calendar.subscription.title'|trans }}</h1>

    {% for message in app.flashes('success') %}
        <p class="flash flash--success">{{ message|trans }}</p>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <p class="flash flash--error">{{ message|trans }}</p>
    {% endfor %}

    {% if url %}
        <p>{{ 'calendar.subscription.intro'|trans }}</p>

        <p><code class="feed-url">{{ url }}</code></p>

        <p class="muted">{{ 'calendar.subscription.copy_now'|trans|raw }}</p>
    {% else %}
        <p>{{ 'calendar.subscription.already_exists'|trans }}</p>
        <p class="muted">{{ 'calendar.subscription.cannot_show_again'|trans }}</p>
    {% endif %}

    <p class="muted">{{ 'calendar.subscription.privacy'|trans }}</p>

    <form method="post" action="{{ path('calendar_subscription') }}"
          onsubmit="return confirm('{{ 'calendar.subscription.regenerate_confirm'|trans|e('js') }}')">
        <input type="hidden" name="_token" value="{{ csrf_token('calendar_feed_' ~ userId) }}">
        <button type="submit">{{ 'calendar.subscription.regenerate'|trans }}</button>
    </form>
{% endblock %}
