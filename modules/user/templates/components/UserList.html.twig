<div {{ attributes }} class="contact-list">

    <div class="contact-list__toolbar">
        <input
            type="search"
            value="{{ this.query }}"
            data-model="debounce(200)|query"
            placeholder="{{ 'user.list.search_placeholder'|trans }}"
            autocomplete="off"
            aria-label="{{ 'user.list.search_label'|trans }}"
            class="contact-list__search"
        >
        <span class="contact-list__count" data-loading="addClass(is-busy)">
            {% if this.isFiltered %}
                {{ 'user.list.filtered_count'|trans({'%shown%': this.users|length, '%total%': this.total}) }}
            {% else %}
                {{ 'user.list.total_count'|trans({'%count%': this.total}) }}
            {% endif %}
        </span>
    </div>

    {% if this.users is empty %}
        <p class="contact-list__empty">
            {% if this.isFiltered %}
                {{ 'user.list.no_match'|trans({'%query%': this.query})|raw }}
            {% else %}
                {{ 'user.list.none_yet'|trans }}
            {% endif %}
        </p>
    {% else %}
        <table class="contact-list__table">
            <thead>
                <tr>
                    <th scope="col">{{ 'user.list.column.name'|trans }}</th>
                    <th scope="col">{{ 'user.list.column.email'|trans }}</th>
                    <th scope="col">{{ 'user.list.column.team'|trans }}</th>
                    <th scope="col">{{ 'user.list.column.roles'|trans }}</th>
                    <th scope="col">{{ 'user.list.column.status'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for user in this.users %}
                    <tr>
                        <td>{{ user.name }}</td>
                        <td><a href="mailto:{{ user.email }}">{{ user.email }}</a></td>
                        <td>{{ user.team ? user.team.name : '—' }}</td>
                        <td>{{ user.roles|join(', ') }}</td>
                        <td>
                            {% if user.active %}
                                {{ 'user.list.active'|trans }}
                            {% else %}
                                <span class="muted">{{ 'user.list.inactive'|trans }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% if this.isTruncated %}
            <p class="contact-list__note">{{ 'user.list.truncated'|trans }}</p>
        {% endif %}
    {% endif %}
</div>
