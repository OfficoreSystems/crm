{# Firmen- und Kontaktnamen stehen nicht in dieser Tabelle. Der Suchbegriff
   wird ueber die Finder aus dem Shared Kernel zu IDs aufgeloest. #}
<div {{ attributes }} class="pipeline">

    <div class="contact-list__toolbar">
        <input
            type="search"
            value="{{ this.query }}"
            data-model="debounce(200)|query"
            placeholder="Nach Titel, Firma oder Kontakt suchen …"
            autocomplete="off"
            aria-label="Verkaufschancen durchsuchen"
            class="contact-list__search"
        >
        <span class="contact-list__count" data-loading="addClass(is-busy)">
            {{ this.total }} {{ this.total == 1 ? 'Chance' : 'Chancen' }}
        </span>
    </div>

    <div class="pipeline__summary">
        <span class="pipeline__metric">
            <strong>{{ this.openValue.asDecimal }} {{ this.openValue.currency }}</strong>
            <span class="muted">offen</span>
        </span>
        <span class="pipeline__metric">
            {% if this.winRate is null %}
                <strong>&mdash;</strong>
                <span class="muted">noch nichts abgeschlossen</span>
            {% else %}
                <strong>{{ this.winRate }} %</strong>
                <span class="muted">gewonnen</span>
            {% endif %}
        </span>
    </div>

    <div class="pipeline__board">
        {% for stage in this.stages %}
            {% set deals = this.dealsIn(stage) %}
            {% set total = this.valueIn(stage) %}
            <section class="pipeline__column pipeline__column--{{ stage.value }}">
                <header class="pipeline__column-head">
                    <span class="pipeline__stage">{{ stage.label }}</span>
                    <span class="pipeline__stage-count">{{ deals|length }}</span>
                </header>

                {% if total.isZero %}
                    <p class="pipeline__column-sum muted">&mdash;</p>
                {% else %}
                    <p class="pipeline__column-sum">{{ total.asDecimal }} {{ total.currency }}</p>
                {% endif %}

                {% for deal in deals %}
                    <article class="pipeline__card">
                        <p class="pipeline__card-title">{{ deal.title }}</p>
                        <p class="pipeline__card-value">{{ deal.value.asDecimal }} {{ deal.value.currency }}</p>
                        {% set company = this.companyNameFor(deal) %}
                        {% set contact = this.contactNameFor(deal) %}
                        {% if company or contact %}
                            <p class="pipeline__card-meta">
                                {{ company ?? '' }}{% if company and contact %} · {% endif %}{{ contact ?? '' }}
                            </p>
                        {% endif %}
                    </article>
                {% else %}
                    <p class="pipeline__empty muted">leer</p>
                {% endfor %}
            </section>
        {% endfor %}
    </div>

    {% if this.total == 0 %}
        <p class="contact-list__empty">
            Noch keine Verkaufschancen angelegt.
            Leg welche an mit <code>bin/console deal:seed</code>.
        </p>
    {% endif %}
</div>
