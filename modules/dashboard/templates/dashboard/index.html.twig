{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'dashboard.title'|trans }}</h1>

    {# Die Kacheln kommen aus der MetricRegistry. Welche es gibt, entscheiden
       die installierten Module - hier steht kein Modulname. #}
    {% if metrics is empty %}
        <p class="lede">{{ 'dashboard.empty'|trans|raw }}</p>
    {% else %}
        <p class="lede">
            {{ 'dashboard.summary'|trans({
                '%metrics%': metrics|length,
                '%modules%': metrics|map(m => m.module)|reduce((carry, m) => m in carry ? carry : carry|merge([m]), [])|length,
            }) }}
        </p>

        {% if notable is not empty %}
            <div class="metrics metrics--notable">
                {% for metric in notable %}
                    {{ _self.tile(metric) }}
                {% endfor %}
            </div>
        {% endif %}

        <div class="metrics">
            {% for metric in metrics %}
                {% if metric not in notable %}
                    {{ _self.tile(metric) }}
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

{# Label und Beschreibung sind Uebersetzungsschluessel - uebersetzt wird hier
   und nicht im Modul. Grund: die Kennzahlen entstehen in der
   Infrastructure-Schicht, und die darf Symfony nicht sehen. #}
{% macro tile(metric) %}
    <article class="metric metric--{{ metric.tone.value }}">
        <p class="metric__label">{{ metric.label|trans(metric.parameters) }}</p>
        <p class="metric__value">
            {# Nur Geldbetraege werden umformatiert - Prozentwerte und Anzahlen
               nach Waehrungsregeln zu behandeln waere schlimmer als gar
               nichts. #}
            {% if metric.currency %}
                {{ metric.value|format_currency(metric.currency) }}
            {% else %}
                {{ metric.value }}
            {% endif %}
        </p>
        {% if metric.description %}
            <p class="metric__description">{{ metric.description|trans(metric.parameters) }}</p>
        {% endif %}
        {% if metric.isLinkable %}
            <a class="metric__link" href="{{ path(metric.route, metric.routeParameters) }}">
                {{ 'dashboard.view'|trans }}
            </a>
        {% endif %}
    </article>
{% endmacro %}
