{% extends 'base.html.twig' %}

{% block title %}{{ 'document.title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'document.title'|trans }}</h1>

    {% if documents is empty %}
        <p class="muted">{{ 'document.list.empty'|trans }}</p>
    {% else %}
        <table class="contact-list__table">
            <thead>
                <tr>
                    <th scope="col">{{ 'document.list.column.file'|trans }}</th>
                    <th scope="col">{{ 'document.list.column.belongs_to'|trans }}</th>
                    <th scope="col">{{ 'document.list.column.size'|trans }}</th>
                    <th scope="col">{{ 'document.list.column.uploaded'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for document in documents %}
                    {% set label = labels[document.subject.key]|default(null) %}
                    <tr>
                        <td>
                            <a href="{{ path('document_download', {document: document.id}) }}">
                                {{ document.filename }}
                            </a>
                        </td>
                        <td>
                            {% if label %}
                                <a href="{{ path('document_for_subject', {
                                    type: document.subject.type,
                                    id: document.subject.id,
                                }) }}">{{ label.label }}</a>
                                <span class="muted">({{ label.typeLabel|trans }})</span>
                            {% else %}
                                {# Das Modul, das diesen Typ aufloest, ist nicht
                                   installiert. Die Datei bleibt erreichbar. #}
                                <span class="muted">{{ 'document.list.unresolved_subject'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>{{ document.size|document_size }}</td>
                        <td>{{ document.uploadedAt|format_datetime('medium', 'short') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
