{% extends 'base.html.twig' %}

{% block title %}
    {{ 'document.title'|trans }}{% if label %} &mdash; {{ label.label }}{% endif %}
{% endblock %}

{% block body %}
    <p><a href="{{ path('document_index') }}">&larr; {{ 'document.back_to_all'|trans }}</a></p>

    <h1>
        {% if label %}
            {{ 'document.title_for'|trans({'%subject%': label.label}) }}
        {% else %}
            {{ 'document.title'|trans }}
        {% endif %}
    </h1>

    {% if not label %}
        <p class="muted">{{ 'document.list.unresolved_hint'|trans }}</p>
    {% endif %}

    {% for message in app.flashes('success') %}
        <p class="flash flash--success">{{ message|trans }}</p>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <p class="flash flash--error">{{ message|trans }}</p>
    {% endfor %}

    {% if is_granted('document.create') %}
        <form
            method="post"
            action="{{ path('document_upload', {type: subject.type, id: subject.id}) }}"
            enctype="multipart/form-data"
            class="upload"
        >
            <label for="file">{{ 'document.upload.label'|trans }}</label>
            <input type="file" id="file" name="file" required>
            <button type="submit">{{ 'document.upload.submit'|trans }}</button>
        </form>
    {% endif %}

    {% if documents is empty %}
        <p class="muted">{{ 'document.list.empty_for_subject'|trans }}</p>
    {% else %}
        <table class="contact-list__table">
            <thead>
                <tr>
                    <th scope="col">{{ 'document.list.column.file'|trans }}</th>
                    <th scope="col">{{ 'document.list.column.size'|trans }}</th>
                    <th scope="col">{{ 'document.list.column.uploaded'|trans }}</th>
                    <th scope="col"><span class="visually-hidden">{{ 'document.list.column.actions'|trans }}</span></th>
                </tr>
            </thead>
            <tbody>
                {% for document in documents %}
                    <tr>
                        <td>
                            <a href="{{ path('document_download', {document: document.id}) }}">
                                {{ document.filename }}
                            </a>
                        </td>
                        <td>{{ document.size|document_size }}</td>
                        <td>{{ document.uploadedAt|format_datetime('medium', 'short') }}</td>
                        <td>
                            {% if is_granted('document.delete', document) %}
                                <form
                                    method="post"
                                    action="{{ path('document_delete', {document: document.id}) }}"
                                    onsubmit="return confirm('{{ 'document.delete.confirm'|trans|e('js') }}')"
                                >
                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('document_delete_' ~ document.id) }}"
                                    >
                                    <button type="submit" class="link-button">
                                        {{ 'document.delete.submit'|trans }}
                                    </button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
