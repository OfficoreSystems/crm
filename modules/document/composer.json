{
    "name": "crm/document-module",
    "description": "Dokumente: Dateien an beliebigen Datensaetzen, im Objektspeicher.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "version": "0.1.0",
    "require": {
        "php": ">=8.2",
        "crm/shared-kernel": "^0.1",
        "doctrine/doctrine-bundle": "^2.19 || ^3.0",
        "doctrine/orm": "^3.6",
        "league/flysystem": "^3.35",
        "league/flysystem-async-aws-s3": "^3.31",
        "league/flysystem-bundle": "^3.7",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/mime": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-http": "^7.4",
        "symfony/uid": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Crm\\Document\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crm\\Document\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
