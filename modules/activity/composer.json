{
    "name": "crm/activity-module",
    "description": "Aktivitaeten und Timeline an beliebigen Datensaetzen.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "version": "0.1.0",
    "require": {
        "php": ">=8.2",
        "crm/shared-kernel": "^0.1",
        "doctrine/doctrine-bundle": "^2.19 || ^3.0",
        "doctrine/orm": "^3.6",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/uid": "^7.4",
        "symfony/ux-live-component": "^2.36"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Crm\\Activity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crm\\Activity\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
