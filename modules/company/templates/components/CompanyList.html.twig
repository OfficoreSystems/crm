<div {{ attributes }} class="contact-list">

    <div class="contact-list__toolbar">
        <input
            type="search"
            value="{{ this.query }}"
            data-model="debounce(200)|query"
            placeholder="{{ 'company.list.search_placeholder'|trans }}"
            autocomplete="off"
            aria-label="{{ 'company.list.search_label'|trans }}"
            class="contact-list__search"
        >
        <span class="contact-list__count" data-loading="addClass(is-busy)">
            {% if this.isFiltered %}
                {{ 'company.list.filtered_count'|trans({'%shown%': this.companies|length, '%total%': this.total}) }}
            {% else %}
                {{ 'company.list.total_count'|trans({'%count%': this.total}) }}
            {% endif %}
        </span>
    </div>

    {% set industries = this.topIndustries %}
    {% if industries is not empty and not this.isFiltered %}
        <p class="contact-list__note">
            {{ 'company.list.top_industries'|trans }}
            {% for industry, count in industries %}
                <button type="button" data-model="query" value="{{ industry }}"
                        class="contact-list__chip">{{ industry }} ({{ count }})</button>
            {% endfor %}
        </p>
    {% endif %}

    {% if this.companies is empty %}
        <p class="contact-list__empty">
            {% if this.isFiltered %}
                {{ 'company.list.no_match'|trans({'%query%': this.query})|raw }}
            {% else %}
                {{ 'company.list.none_yet'|trans|raw }}
            {% endif %}
        </p>
    {% else %}
        <table class="contact-list__table">
            <thead>
                <tr>
                    <th scope="col">{{ 'company.list.column.name'|trans }}</th>
                    <th scope="col">{{ 'company.list.column.industry'|trans }}</th>
                    <th scope="col">{{ 'company.list.column.city'|trans }}</th>
                    <th scope="col">{{ 'company.list.column.contacts'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for company in this.companies %}
                    <tr>
                        <td>
                            {% if company.website %}
                                <a href="{{ company.website }}" rel="noopener noreferrer" target="_blank">{{ company.name }}</a>
                            {% else %}
                                {{ company.name }}
                            {% endif %}
                        </td>
                        <td>{{ company.industry ?? '—' }}</td>
                        <td>
                            {% if company.address.isEmpty %}
                                <span class="muted">&mdash;</span>
                            {% else %}
                                {{ company.address.asLine }}
                            {% endif %}
                        </td>
                        <td>
                            {% if company.email %}
                                <a href="mailto:{{ company.email }}">{{ company.email }}</a>
                            {% else %}
                                <span class="muted">&mdash;</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% if this.isTruncated %}
            <p class="contact-list__note">{{ 'company.list.truncated'|trans }}</p>
        {% endif %}
    {% endif %}
</div>
