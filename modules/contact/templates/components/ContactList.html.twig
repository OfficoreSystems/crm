{# Live-Component: jede Aenderung an `query` rendert nur diesen Block neu.

   "Firma" ist keine Spalte dieser Tabelle - der Suchbegriff wird ueber den
   CompanyFinder aus dem Shared Kernel zu IDs aufgeloest und damit gefiltert. #}
<div {{ attributes }} class="contact-list">

    <div class="contact-list__toolbar">
        <input
            type="search"
            value="{{ this.query }}"
            data-model="debounce(200)|query"
            placeholder="{{ 'contact.list.search_placeholder'|trans }}"
            autocomplete="off"
            aria-label="{{ 'contact.list.search_label'|trans }}"
            class="contact-list__search"
        >
        <span class="contact-list__count" data-loading="addClass(is-busy)">
            {% if this.isFiltered %}
                {{ 'contact.list.filtered_count'|trans({'%shown%': this.contacts|length, '%total%': this.total}) }}
            {% else %}
                {{ 'contact.list.total_count'|trans({'%count%': this.total}) }}
            {% endif %}
        </span>
    </div>

    {% if this.contacts is empty %}
        <p class="contact-list__empty">
            {% if this.isFiltered %}
                {{ 'contact.list.no_match'|trans({'%query%': this.query})|raw }}
            {% else %}
                {{ 'contact.list.none_yet'|trans|raw }}
            {% endif %}
        </p>
    {% else %}
        <table class="contact-list__table">
            <thead>
                <tr>
                    <th scope="col">{{ 'contact.list.column.name'|trans }}</th>
                    <th scope="col">{{ 'contact.list.column.email'|trans }}</th>
                    <th scope="col">{{ 'contact.list.column.company'|trans }}</th>
                    <th scope="col">{{ 'contact.list.column.created'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for contact in this.contacts %}
                    <tr>
                        <td>{{ contact.fullName }}</td>
                        <td>
                            {% if contact.email %}
                                <a href="mailto:{{ contact.email }}">{{ contact.email }}</a>
                            {% else %}
                                <span class="muted">&mdash;</span>
                            {% endif %}
                        </td>
                        <td>
                            {# Kann leer sein: kein Firmenbezug, geloeschte Firma
                               oder company-Modul nicht installiert. #}
                            {{ this.companyNameFor(contact) ?? '—' }}
                        </td>
                        <td>
                            {# format_date statt date('d.m.Y'): das Format kommt
                               aus der Sprache des Betrachters, nicht aus dem
                               Template. #}
                            <time datetime="{{ contact.createdAt|date('c') }}">
                                {{ contact.createdAt|format_date('medium') }}
                            </time>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% if this.isTruncated %}
            <p class="contact-list__note">{{ 'contact.list.truncated'|trans }}</p>
        {% endif %}
    {% endif %}
</div>
