<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}CRM{% endblock %} · Officore</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='14' font-size='14'>◆</text></svg>">

    {# Bewusst inline: das Grundlayout soll ohne Asset-Pipeline stehen.
       Modul-eigene Styles gehoeren in den AssetMapper. #}
    <style>
        :root {
            --bg: #ffffff; --fg: #16181d; --muted: #6b7280;
            --line: #e5e7eb; --accent: #2563eb; --surface: #f9fafb;
        }
        @media (prefers-color-scheme: dark) {
            :root {
                --bg: #111318; --fg: #e8eaed; --muted: #9aa1ad;
                --line: #2a2e37; --accent: #7aa2f7; --surface: #181b22;
            }
        }
        * { box-sizing: border-box; }
        body {
            margin: 0; background: var(--bg); color: var(--fg);
            font: 15px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif;
        }
        a { color: var(--accent); }
        .shell { display: flex; min-height: 100vh; }
        .sidebar {
            width: 220px; flex: 0 0 220px; border-right: 1px solid var(--line);
            padding: 1.25rem 1rem; background: var(--surface);
        }
        .sidebar__brand {
            font-weight: 650; letter-spacing: -0.01em; margin: 0 0 1.25rem;
            font-size: 1.05rem;
        }
        .sidebar__nav { list-style: none; margin: 0; padding: 0; }
        .sidebar__nav a {
            display: block; padding: 0.4rem 0.55rem; border-radius: 6px;
            text-decoration: none; color: var(--fg);
        }
        .sidebar__nav a:hover { background: var(--bg); }
        .sidebar__nav a[aria-current="page"] { background: var(--bg); font-weight: 600; }
        .sidebar__empty { color: var(--muted); font-size: 0.85rem; }
        .sidebar__account {
            margin-top: 1.5rem; padding-top: 0.85rem;
            border-top: 1px solid var(--line); font-size: 0.85rem;
        }
        .sidebar__account-name { display: block; color: var(--fg); font-weight: 550; }
        .sidebar__account-logout { color: var(--muted); text-decoration: none; }
        .sidebar__account-logout:hover { color: var(--accent); text-decoration: underline; }

        .auth { display: grid; place-items: center; min-height: 100vh; padding: 1.5rem; }
        .auth__card {
            width: 100%; max-width: 22rem; border: 1px solid var(--line);
            border-radius: 10px; padding: 1.75rem; background: var(--surface);
        }
        .auth__brand { margin: 0 0 1.25rem; font-weight: 650; letter-spacing: -0.01em; }
        .auth__field { display: block; margin-bottom: 0.9rem; }
        .auth__field span { display: block; margin-bottom: 0.3rem; font-size: 0.85rem; color: var(--muted); }
        .auth__field input {
            width: 100%; padding: 0.5rem 0.7rem; border: 1px solid var(--line);
            border-radius: 6px; background: var(--bg); color: var(--fg); font-size: 0.95rem;
        }
        .auth__field input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
        .auth__submit {
            width: 100%; padding: 0.55rem; border: 0; border-radius: 6px;
            background: var(--accent); color: #fff; font-size: 0.95rem;
            font-weight: 550; cursor: pointer;
        }
        .auth__error {
            margin: 0 0 1rem; padding: 0.5rem 0.7rem; border-radius: 6px;
            background: #fee2e2; color: #991b1b; font-size: 0.88rem;
        }
        @media (prefers-color-scheme: dark) {
            .auth__error { background: #3f1d1d; color: #fca5a5; }
        }
        main { flex: 1; padding: 1.75rem 2rem; max-width: 1100px; }
        h1 { font-size: 1.5rem; letter-spacing: -0.02em; margin: 0 0 0.35rem; }
        .lede { color: var(--muted); margin: 0 0 1.5rem; }
        .muted { color: var(--muted); }
        code {
            background: var(--surface); border: 1px solid var(--line);
            border-radius: 4px; padding: 0.1em 0.35em; font-size: 0.9em;
        }

        .contact-list__toolbar {
            display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;
        }
        .contact-list__search {
            flex: 1 1 auto; max-width: 26rem; padding: 0.5rem 0.7rem;
            border: 1px solid var(--line); border-radius: 6px;
            background: var(--bg); color: var(--fg); font-size: 0.95rem;
        }
        .contact-list__search:focus {
            outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent;
        }
        .contact-list__count { color: var(--muted); font-size: 0.85rem; white-space: nowrap; }
        .contact-list__count.is-busy { opacity: 0.45; }
        .contact-list__table { width: 100%; border-collapse: collapse; font-size: 0.93rem; }
        .contact-list__table th {
            text-align: left; font-weight: 600; color: var(--muted);
            font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em;
            padding: 0 0.6rem 0.5rem; border-bottom: 1px solid var(--line);
        }
        .contact-list__table td { padding: 0.55rem 0.6rem; border-bottom: 1px solid var(--line); }
        .contact-list__empty, .contact-list__note { color: var(--muted); }
        .contact-list__chip {
            border: 1px solid var(--line); border-radius: 999px; padding: 0.1rem 0.6rem;
            background: var(--surface); color: var(--fg); font-size: 0.8rem;
            cursor: pointer; margin-right: 0.3rem;
        }

        .pipeline__summary {
            display: flex; gap: 2rem; margin-bottom: 1.25rem; padding-bottom: 1rem;
            border-bottom: 1px solid var(--line);
        }
        .pipeline__metric { display: flex; flex-direction: column; gap: 0.15rem; }
        .pipeline__metric strong { font-size: 1.35rem; letter-spacing: -0.02em; }
        .pipeline__metric .muted { font-size: 0.8rem; }
        .pipeline__board {
            display: grid; grid-auto-flow: column; grid-auto-columns: minmax(11rem, 1fr);
            gap: 0.75rem; overflow-x: auto; padding-bottom: 0.5rem;
        }
        .pipeline__column {
            background: var(--surface); border: 1px solid var(--line);
            border-radius: 8px; padding: 0.7rem;
        }
        .pipeline__column-head {
            display: flex; justify-content: space-between; align-items: baseline;
        }
        .pipeline__stage { font-weight: 600; font-size: 0.85rem; }
        .pipeline__stage-count { color: var(--muted); font-size: 0.8rem; }
        .pipeline__column-sum {
            margin: 0.15rem 0 0.7rem; font-size: 0.8rem; color: var(--muted);
            font-variant-numeric: tabular-nums;
        }
        .pipeline__column--won { border-color: #16a34a55; }
        .pipeline__column--lost { border-color: #dc262655; }
        .pipeline__card {
            background: var(--bg); border: 1px solid var(--line); border-radius: 6px;
            padding: 0.5rem 0.6rem; margin-bottom: 0.45rem;
        }
        .pipeline__card-title { margin: 0; font-size: 0.87rem; font-weight: 550; }
        .pipeline__card-value {
            margin: 0.15rem 0 0; font-size: 0.82rem; font-variant-numeric: tabular-nums;
        }
        .pipeline__card-meta { margin: 0.2rem 0 0; font-size: 0.76rem; color: var(--muted); }
        .pipeline__empty { font-size: 0.8rem; }
    </style>

    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
{# Die Anmeldeseite ersetzt diesen Block: dort gibt es weder Navigation noch
   einen angemeldeten Benutzer, auf den sie sich beziehen koennte. #}
{% block shell %}
<div class="shell">
    <aside class="sidebar">
        <p class="sidebar__brand">◆ Officore CRM</p>

        {# Der Core fragt die Registry, nicht die Module. Wer hier auftaucht,
           entscheidet sich dadurch, welche Bundles installiert sind. #}
        {% set menu = crm_menu() %}
        {% if menu is empty %}
            <p class="sidebar__empty">Kein Modul installiert.</p>
        {% else %}
            <ul class="sidebar__nav">
                {% for item in menu %}
                    <li>
                        <a href="{{ path(item.route) }}"
                           {% if app.request and app.request.attributes.get('_route') == item.route %}aria-current="page"{% endif %}>
                            {{ item.label }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {# Nur sichtbar, wenn ueberhaupt jemand angemeldet ist - ohne
           user-Modul ist app.user immer null und der Block entfaellt.
           Bewusst die literale URL statt path('user_logout'): ein Routenname
           waere eine Kopplung an ein bestimmtes Modul, der Logout-Pfad ist
           dagegen Firewall-Konfiguration. #}
        {% if app.user %}
            <div class="sidebar__account">
                <span class="sidebar__account-name">{{ app.user.name|default(app.user.userIdentifier) }}</span>
                <a href="/logout" class="sidebar__account-logout">Abmelden</a>
            </div>
        {% endif %}
    </aside>

    <main>
        {% block body %}{% endblock %}
    </main>
</div>
{% endblock %}
</body>
</html>
